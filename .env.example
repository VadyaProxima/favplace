# Переменные для docker-compose (прод-сервер).
# Скопируйте в .env рядом с docker-compose.yml: cp .env.example .env
# Сам .env в git не попадает.
#
# Локальная разработка это НЕ читает — там свой apps/api/.env.

# Домен сайта. Должен A-записью указывать на IP сервера — по нему
# Caddy выпустит сертификат. Для теста без домена можно указать IP,
# но тогда HTTPS не будет.
SITE_DOMAIN=favplace.ru

# Пароль пользователя postgres. Задайте длинный случайный:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Служебный вход на /admin — он открывает кнопку «Скачать STL».
# Пароль знаете только вы, клиентам он не нужен.
ADMIN_PASSWORD=
# Ключ подписи куки сессии. Смена ключа разлогинивает.
#   openssl rand -base64 48
SESSION_SECRET=

# --- необязательное ---------------------------------------------------------
# Уведомления о заявках в Telegram. Без них заявка сохраняется в БД
# и пишется в лог, но менеджеру не уходит.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI-камера /api/ai/identify-place
OPENAI_API_KEY=

MAPBOX_ACCESS_TOKEN=
