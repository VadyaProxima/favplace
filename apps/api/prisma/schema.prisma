generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Заявка из конструктора. Регистрации в проекте нет: клиент собирает
/// кольцо, оставляет контакты, дальше с ним связывается менеджер.
model Order {
  id     String @id @default(cuid())
  /// Человекочитаемый номер для писем и звонков: FP-000123.
  /// Выдаётся секвенцией order_number_seq — см. OrdersService.nextNumber.
  number String @unique
  status String @default("draft")

  /// Пересчитанная на сервере сумма. Присланной с клиента цене не верим.
  totalPrice Float @default(0)

  /// Снапшот конфигуратора на момент заявки (CheckoutConfig)
  configJson String?
  /// Ссылка на конструктор с этой же конфигурацией
  shareUrl   String?

  customerName  String?
  customerPhone String?
  customerEmail String?
  delivery      String?
  comment       String?
  promo         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
