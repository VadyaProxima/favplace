# Локальная разработка. Скопируйте в apps/api/.env и подставьте свои значения.
# Сам .env в git не попадает (см. .gitignore) — токены наружу не уедут.
#
# Для прод-сервера этот файл не нужен: там переменные задаются в корневом
# .env, который читает docker-compose (см. .env.example в корне репозитория).

# Подключение к PostgreSQL. Поднять локальную БД одной командой:
#   docker run -d --name favplace-db -p 5432:5432 \
#     -e POSTGRES_USER=favplace -e POSTGRES_PASSWORD=favplace \
#     -e POSTGRES_DB=favplace postgres:16-alpine
# затем: pnpm --filter @favplace/api prisma:migrate
DATABASE_URL=postgresql://favplace:favplace@localhost:5432/favplace?schema=public

# Карта (уже настроено)
MAPBOX_ACCESS_TOKEN=

# Служебный вход на /admin — открывает кнопку «Скачать STL».
# Без обеих переменных вход просто недоступен (а не «подойдёт пустой пароль»).
ADMIN_PASSWORD=
SESSION_SECRET=

# AI-камера /api/ai/identify-place — необязательно
OPENAI_API_KEY=

# Уведомления о заявках из конструктора.
# Без этих двух переменных заявка сохраняется в БД и пишется в лог API,
# но никуда не отправляется.
#
# 1. TELEGRAM_BOT_TOKEN — выдаёт @BotFather по команде /newbot.
#    Выглядит как 1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 2. TELEGRAM_CHAT_ID — куда слать. Это ваш личный id, а не имя бота.
#    Напишите своему боту любое сообщение, затем откройте в браузере
#    https://api.telegram.org/bot<ТОКЕН>/getUpdates
#    и возьмите число из result[0].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
